# Truth Hunter Phase 1 development configuration.
# Copy this file to .env and replace every CHANGE_ME value before production.
APP_ENV=development
APP_NAME=Truth Hunter
APP_VERSION=0.1.0
APP_SECRET=development-only-change-me
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_TRUSTED_HOSTS=localhost,127.0.0.1,truthhunter

POSTGRES_DB=truthhunter
POSTGRES_USER=truthhunter
POSTGRES_PASSWORD=development-only-change-me
DATABASE_URL=postgresql+psycopg://truthhunter:development-only-change-me@postgres:5432/truthhunter

# Free providers are tried in order. Missing keys skip that provider.
# Paid fallback is disabled unless explicitly enabled and bounded.
AI_PROVIDER_ORDER=groq,gemini,openrouter,deepseek
ALLOW_PAID_AI_FALLBACK=false
AI_MAX_PAID_FALLBACK_CALLS=0

# Legacy primary settings remain supported.
AI_PROVIDER=groq
AI_API_KEY=development-only-change-me
AI_MODEL=openai/gpt-oss-120b

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

SEARXNG_URL=http://searxng:8080
SEARXNG_SECRET=development-only-change-me
SEARCH_RESULT_LIMIT=20
SEARCH_DELAY_SECONDS=1.0
SEARCH_RETRY_ATTEMPTS=1
SOURCE_USEFUL_LIMIT=15
SOURCE_EVALUATION_LIMIT=15
AI_SOURCE_TEXT_MAX_CHARS=12000
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=2000000
FETCH_REDIRECT_LIMIT=4

# Phase 4 accounts. Development email links stay in process memory.

PUBLIC_BASE_URL=http://localhost
EMAIL_DELIVERY_MODE=development
RESEND_API_KEY=
RESEND_FROM_EMAIL=Truth Hunter <accounts@example.com>
EMAIL_TOKEN_MAX_AGE_SECONDS=86400
RESET_TOKEN_MAX_AGE_SECONDS=3600
AUTH_ATTEMPT_LIMIT=8
AUTH_ATTEMPT_WINDOW_SECONDS=900
ADMIN_EMAILS=admin@example.com
ADMIN_ACCESS_MAX_AGE_SECONDS=600
ADMIN_SESSION_MAX_AGE_SECONDS=1800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Use :80 for local HTTP. Replace with a real domain for later production setup.
CADDY_SITE_ADDRESS=:80
